# Copy to .env and adjust. No secrets belong in source code.

# Server port (npm run serve). Optional HOST= to bind one interface only.
PORT=3000

# SQLite database file (created automatically on first start)
DATABASE_PATH=./data/andon.db

# Folder for uploaded ANDON photos
UPLOAD_DIR=./data/uploads

# Public base URL used in notification links (use the server's LAN IP for phones,
# e.g. http://192.168.0.10:3000)
APP_BASE_URL=http://localhost:3000

# Notification provider: mock (default). Future: kakao
NOTIFICATION_PROVIDER=mock

# --- Future KakaoTalk provider (not used yet; keep real values only in .env) ---
# KAKAO_API_BASE_URL=
# KAKAO_API_KEY=
# KAKAO_SENDER_KEY=
# KAKAO_TEMPLATE_CODE=
