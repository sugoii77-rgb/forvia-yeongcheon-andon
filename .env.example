# Copy to .env and adjust. No secrets belong in source code.

# Server port (npm run serve). Optional HOST= to bind one interface only.
PORT=3000

# SQLite database file (created automatically on first start)
DATABASE_PATH=./data/andon.db

# Folder for uploaded ANDON photos
UPLOAD_DIR=./data/uploads

# Public base URL used in notification links (use the server's LAN IP for phones,
# e.g. http://192.168.0.10:3000)
APP_BASE_URL=http://localhost:3000

# Login sessions (Milestone 2B). Session length in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Session cookie "Secure" flag: auto (only when the request is HTTPS), true, or false.
# The plant LAN currently uses plain HTTP → keep "auto"; set "true" once HTTPS is in place.
COOKIE_SECURE=auto

# Google OIDC (additional provider; LOCAL login stays available).
# Create a Web application OAuth client. Never put real secrets in this template.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local example (the existing development supervisor uses port 3100):
GOOGLE_REDIRECT_URI=http://localhost:3100/api/auth/google/callback
# External pilot MUST use its exact public HTTPS callback and COOKIE_SECURE=true.

# Notification provider: mock (default). Future: kakao
NOTIFICATION_PROVIDER=mock

# --- Future KakaoTalk provider (not used yet; keep real values only in .env) ---
# Note: notification identity (Kakao recipient) is stored per user in user_notification_channel,
# separate from login identity (user_identity). Never derive one from the other.
# KAKAO_API_BASE_URL=
# KAKAO_API_KEY=
# KAKAO_SENDER_KEY=
# KAKAO_TEMPLATE_CODE=
